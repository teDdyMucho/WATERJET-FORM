# ============================================================
# WATERJET CONTACT FORM — environment variables
# ============================================================
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file or paste its contents in chat.
#
# WHERE EACH VALUE IS USED:
#   - "Client (form HTML)" values are safe to expose publicly —
#     they get baked into the WordPress-embedded form's JS.
#   - "Edge Function secret" values are SENSITIVE and must only be
#     set via `supabase secrets set`, never placed in the HTML form
#     or any file that ends up in the browser.
# ============================================================

# --- Client (form HTML) -------------------------------------------------

# Supabase project URL. Found in Supabase Dashboard > Project Settings > API.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon/public key. Safe for client-side use — protected by RLS.
SUPABASE_ANON_KEY=your-anon-public-key

# Name of the Edge Function the form submits to (default provided).
SUPABASE_FUNCTION_NAME=submit-contact-form


# --- Edge Function secrets (server-side only) ----------------------------
# Set these with the Supabase CLI, e.g.:
#   supabase secrets set VIRUSTOTAL_API_KEY=xxx SERVICE_ROLE_KEY=xxx
# Do NOT put these in the form's HTML/JS.

# Service role key. Found in Supabase Dashboard > Project Settings > API.
# Grants full DB/storage access — required so the Edge Function can move
# files out of the private "quarantine" bucket after a clean scan.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# VirusTotal API key. Get a free key at https://www.virustotal.com/gui/join-us
# Free tier: 4 requests/minute, 500/day — fine for a low-traffic contact form.
VIRUSTOTAL_API_KEY=your-virustotal-api-key
